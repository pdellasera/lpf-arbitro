# URL base del backend real (opcional). Si se define, el login llama a la API.
# Si se deja vacío, se usa un mock local para desarrollo.
VITE_API_URL=

# '1' = desactiva el service worker de desarrollo (sw-dev.js). Útil para depurar
# problemas de caché/HMR sin SW de ningún tipo en `vite dev`.
# VITE_PWA_NO_DEV_SW=1
